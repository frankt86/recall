{
  "description": "recall hooks. Every hook is a short SQLite write; the processor is spawned detached and exits when the queue is empty.",
  "hooks": {
    "Setup": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "cd \"$CLAUDE_PLUGIN_ROOT\" && bun install --silent >/dev/null 2>&1; bun \"$CLAUDE_PLUGIN_ROOT/src/cli.ts\" doctor", "timeout": 300 }
      ]}
    ],
    "SessionStart": [
      { "matcher": "startup|clear|compact", "hooks": [
        { "type": "command", "command": "bun \"$CLAUDE_PLUGIN_ROOT/src/hooks/session-start.ts\"", "timeout": 30 }
      ]}
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "bun \"$CLAUDE_PLUGIN_ROOT/src/hooks/user-prompt.ts\"", "timeout": 15 }
      ]}
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [
        { "type": "command", "command": "bun \"$CLAUDE_PLUGIN_ROOT/src/hooks/post-tool-use.ts\"", "timeout": 15, "async": true }
      ]}
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bun \"$CLAUDE_PLUGIN_ROOT/src/hooks/stop.ts\"", "timeout": 15 }
      ]}
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "bun \"$CLAUDE_PLUGIN_ROOT/src/hooks/session-end.ts\"", "timeout": 15 }
      ]}
    ]
  }
}
